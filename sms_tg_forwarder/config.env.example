# Example config. The active file is inside the Magisk module:
# /data/adb/modules/sms_tg_forwarder/config.env

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Android SMS/MMS provider database.
DB_PATH=/data/user_de/0/com.android.providers.telephony/databases/mmssms.db

# Keep empty to use /data/adb/sms_tg_forwarder/last_id.txt.
LAST_ID_PATH=

PROXY_URL=http://127.0.0.1:7890

# Android system root CA directory. Keep this default unless your ROM differs.
CA_CERT_DIR=/system/etc/security/cacerts

# Optional PEM CA bundle/file, useful if your proxy performs TLS interception.
CA_CERT_FILE=

# Debug fallback only. Keep false for normal use.
TLS_INSECURE_SKIP_VERIFY=false
