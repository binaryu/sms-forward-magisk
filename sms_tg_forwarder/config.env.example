# Example config. The active file is inside the Magisk module:
# /data/adb/modules/sms_tg_forwarder/config.env
# 注意：修改后重启手机或执行 kill -9 $(cat /data/adb/sms_tg_forwarder/daemon.pid) 即可生效
# 支持通道：Apprise API、通用 Webhook、Telegram（可单独配置任一通道，也可多个同时开启）

# ================= 1. Apprise API 配置 =================
# 方案 A (推荐)：使用 Apprise 后台创建的 KEY，如 /notify/sms
APPRISE_URL=http://192.168.1.100:8000/notify/sms

# 消息标题（可选，留空默认为：收到来自 {{from}} 的短信）
APPRISE_TITLE=收到来自 {{from}} 的短信

# 消息通知级别（可选，默认 info，可选：info, success, warning, failure）
APPRISE_TYPE=info

# 消息正文格式（可选，默认 text，可选：text, markdown, html）
APPRISE_FORMAT=text

# Apprise 请求是否经过 PROXY_URL 代理（默认 false，局域网自建通常不走代理）
APPRISE_USE_PROXY=false


# ================= 2. 通用 Webhook 配置 =================
# 支持推送到任何自定义 HTTP 接口（钉钉、企业微信、飞书、Bark、Server酱、PushPlus、Discord、Home Assistant 等）
# 占位符支持：
#   {{from}} 或 [from]       - 发信人手机号/名称（URL 中会自动转义，JSON 中会自动转义特殊字符）
#   {{body}} 或 [msg] 或 {{content}} - 短信内容
#   {{timestamp}}            - 当前时间戳（毫秒/秒）
#   {{time}}                 - 格式化时间（yyyy-MM-dd HH:mm:ss）

# Webhook 地址（若不使用请留空）
WEBHOOK_URL=

# 请求方式：POST, GET, PUT, PATCH（默认 POST）
WEBHOOK_METHOD=POST

# 自定义请求头（可选，每行一个，留空默认发送 application/json）
# WEBHOOK_HEADERS=Authorization: Bearer YOUR_TOKEN
# WEBHOOK_HEADERS=Content-Type: application/json
WEBHOOK_HEADERS=

# 请求正文模板（可选，留空默认发送 {"from":"{{from}}","content":"{{body}}","timestamp":{{timestamp}}}）
# 示例 1 - 钉钉自定义机器人：
# WEBHOOK_BODY={"msgtype":"text","text":{"content":"【短信】发信人: {{from}}\n内容: {{body}}"}}
# 示例 2 - 飞书自定义机器人：
# WEBHOOK_BODY={"msg_type":"text","content":{"text":"发信人: {{from}}\n内容: {{body}}"}}
# 示例 3 - Bark GET 模式：
# WEBHOOK_URL=https://api.day.app/your_bark_key/收到来自{{from}}的短信/{{body}}
# WEBHOOK_METHOD=GET
WEBHOOK_BODY=

# Webhook 请求是否走 PROXY_URL 代理（默认 false）
WEBHOOK_USE_PROXY=false


# ================= 3. Telegram 配置 =================
# 可选，若不需要请留空
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ================= 4. 通用底层系统设置 =================
# 安卓系统短信 SQLite 数据库路径（留空将自动智能识别并锁定有短信的活跃数据库）
DB_PATH=

# 自定义 DNS 服务器（解决安卓系统纯静态 Go 程序无法通过 /etc/resolv.conf 解析域名的问题，留空自动使用内置公共 DNS）
DNS_SERVER=223.5.5.5:53

# 记录上一条已转发短信 ID 的文件，留空默认保存在 /data/adb/sms_tg_forwarder/last_id.txt
LAST_ID_PATH=

# HTTP 代理（主要用于 Telegram 或需要翻墙的 Webhook；不需要请留空）
PROXY_URL=

# 安卓系统根证书目录（通常无需修改）
CA_CERT_DIR=/system/etc/security/cacerts

# 可选的自定义 CA 证书文件路径
CA_CERT_FILE=

# 调试参数：跳过 TLS 证书校验（默认 false）
TLS_INSECURE_SKIP_VERIFY=false
