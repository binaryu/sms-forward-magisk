# SMS & Call Forwarder 配置文件
# 实际运行文件位于模块安装目录：/data/adb/modules/sms_tg_forwarder/config.env
# 修改后守护进程会自动检测热重载，亦可手动重启：kill -9 $(cat /data/adb/sms_tg_forwarder/daemon.pid)
# 支持通道：Bark、企业微信机器人、通用 Webhook、Apprise API、Telegram（支持任意单个或多个同时开启）

# ================= 1. Bark 推送配置 (推荐，极简无依赖) =================
# iOS Bark 应用推送，仅需填写你的 Device Key 即可开箱即用！
# 在 iPhone 上的 Bark App 主界面中复制你的专属 key (如：https://api.day.app/abc12345/ 中的 abc12345)
BARK_KEY=

# Bark 服务器地址（默认官方服务器，自建服务器填自建 URL 如 http://192.168.1.100:8080）
BARK_SERVER=https://api.day.app

# Bark 消息分组名称（可选，默认：短信转发）
BARK_GROUP=短信转发

# Bark 提示音（可选，例如：minuet, glass, chime 等）
BARK_SOUND=

# Bark 自定义图标 URL（可选）
BARK_ICON=

# Bark 是否走 PROXY_URL 代理（默认 false）
BARK_USE_PROXY=false


# ================= 2. 企业微信群机器人配置 (推荐) =================
# 在企业微信群聊中添加「群机器人」，复制其 Webhook 完整地址填入下方即可
# 例如：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WECHAT_WEBHOOK=

# 企业微信请求是否走 PROXY_URL 代理（默认 false）
WECHAT_USE_PROXY=false


# ================= 3. 通用 Webhook 配置 =================
# 支持推送到任何自定义 HTTP 接口（钉钉、飞书、Bark GET模式、Server酱、PushPlus、Discord、自建API等）
# 占位符支持：
#   {{type}} 或 [type]       - 类型（短信 / 未接来电）
#   {{TYPE}}                 - 大写英文类型（SMS / CALL）
#   {{from}} 或 [from]       - 发信人/来电号码（URL 与 JSON 均会自动安全转义）
#   {{body}} 或 [msg]        - 短信内容或未接来电说明
#   {{time}}                 - 格式化时间（yyyy-MM-dd HH:mm:ss）
#   {{timestamp}}            - 当前时间戳（毫秒）

# Webhook 地址（留空则不启用）
WEBHOOK_URL=

# 请求方式：POST, GET, PUT（默认 POST）
WEBHOOK_METHOD=POST

# 自定义请求头（可选，每行一个）
# WEBHOOK_HEADERS=Authorization: Bearer YOUR_TOKEN
WEBHOOK_HEADERS=

# 自定义请求体模板（可选，留空默认发送完整 JSON）
# 示例 1 - 钉钉自定义机器人：
# WEBHOOK_BODY={"msgtype":"text","text":{"content":"【{{type}}】来自: {{from}}\n内容: {{body}}\n时间: {{time}}"}}
# 示例 2 - 飞书自定义机器人：
# WEBHOOK_BODY={"msg_type":"text","content":{"text":"【{{type}}】来自: {{from}}\n内容: {{body}}\n时间: {{time}}"}}
# 示例 3 - Bark GET 模式：
# WEBHOOK_URL=https://api.day.app/your_bark_key/{{type}}来自{{from}}/{{body}}
# WEBHOOK_METHOD=GET
WEBHOOK_BODY=

# Webhook 请求是否走 PROXY_URL 代理（默认 false）
WEBHOOK_USE_PROXY=false


# ================= 4. Apprise API 配置 =================
# 支持通过自建 Apprise 服务广播到 150+ 种通知服务
APPRISE_URL=

# 消息标题（可选，留空自动智能匹配：“📩 收到来自 {{from}} 的短信” 或 “📞 未接来电: {{from}}”）
APPRISE_TITLE=

# 消息通知级别（可选，默认 info，可选：info, success, warning, failure）
APPRISE_TYPE=info

# 消息正文格式（可选，默认 text，可选：text, markdown, html）
APPRISE_FORMAT=text

# Apprise 请求是否走 PROXY_URL 代理（默认 false）
APPRISE_USE_PROXY=false


# ================= 5. Telegram Bot 配置 =================
# 可选，若不需要请留空
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ================= 6. 通话记录 (未接来电) 监听配置 =================
# 是否启用通话记录监听与未接来电转发（默认 true，自动检测并监听 calllog.db）
ENABLE_CALL_FORWARD=true

# 通话记录数据库路径（留空将自动智能识别 calllog.db / contacts2.db）
CALL_DB_PATH=

# 触发转发的通话类型代码列表（英文逗号分隔，默认：3,5）
# 代码定义：1=接通来电, 2=呼出去电, 3=未接来电, 4=语音信箱, 5=拒接挂断, 6=拦截来电
CALL_FORWARD_TYPES=3,5

# 记录上一条已转发来电 ID 的文件，留空默认保存在 /data/adb/sms_tg_forwarder/last_call.txt
LAST_CALL_PATH=


# ================= 7. 通用底层与网络设置 =================
# 安卓系统短信 SQLite 数据库路径（留空将自动智能识别并锁定活跃短信数据库）
DB_PATH=

# 自定义 DNS 服务器（解决安卓平台纯静态 Go 程序域名解析问题，留空自动使用内置公共 DNS）
DNS_SERVER=223.5.5.5:53

# 记录上一条已转发短信 ID 的文件，留空默认保存在 /data/adb/sms_tg_forwarder/last_msg.txt
LAST_MSG_PATH=

# 网络代理服务器（支持 HTTP / SOCKS5，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）
PROXY_URL=

# 安卓系统根证书目录（通常无需修改）
CA_CERT_DIR=/system/etc/security/cacerts

# 可选的自定义 CA 证书文件路径
CA_CERT_FILE=

# 调试参数：跳过 TLS 证书校验（默认 false）
TLS_INSECURE_SKIP_VERIFY=false
